# @BotFather dan olingan token
BOT_TOKEN=your_bot_token_here

# Admin panelga kirish huquqiga ega Telegram foydalanuvchi ID lari.
# Bir nechta admin bo'lsa, vergul bilan ajrating: 111111111,222222222
# O'z ID ingizni bilish uchun @userinfobot ga /start yuboring.
ADMIN_IDS=

# MongoDB Atlas ulanish manzili (DOIMIY saqlash uchun — Render'da bo'lmasa,
# admin panel orqali qo'shilgan narsalar qayta deploy'da yo'qoladi!)
# Namuna: mongodb+srv://foydalanuvchi:parol@cluster0.xxxxx.mongodb.net/teatr_bot
MONGODB_URI=
